<header class="sticky top-0 z-50 border-b border-slate-800 bg-slate-950/95 backdrop-blur">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8" aria-label="Hauptnavigation">
        <a href="/" class="flex items-center gap-3" aria-label="{{ firma.name }} – Startseite">
            <img src="/logo-mark.svg" alt="" width="85" height="30" class="h-8 w-auto sm:h-9">
            <span class="whitespace-nowrap text-base font-semibold tracking-wide text-orange-500 sm:text-lg">Elektrotechnik GmbH</span>
        </a>

        <div class="hidden md:flex md:items-center md:gap-6">
