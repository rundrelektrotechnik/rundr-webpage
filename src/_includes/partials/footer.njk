{# All company data comes from content/firma.yml #}
{% set linkClass = "transition-colors hover:text-amber-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950" %}
<footer class="bg-slate-950 text-slate-200">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="grid gap-10 md:grid-cols-3">
            <div>
                <div class="flex items-center gap-3">
                    <img src="/logo.svg" alt="{{ firma.name }}" width="173" height="48" class="h-12 w-auto">
                </div>
                <p class="mt-4 text-sm leading-relaxed text-slate-300">
                    {{ firma.kurzbeschreibung }}
                </p>
            </div>

            <nav aria-label="Footer-Navigation">
                <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Navigation</h2>
                <ul class="mt-4 space-y-3 text-sm">
                    <li><a href="/" class="{{ linkClass }}">Home</a></li>
                    <li><a href="/leistungen.html" class="{{ linkClass }}">Leistungen</a></li>
                    <li><a href="/kontakt.html" class="{{ linkClass }}">Kontakt</a></li>
                </ul>
            </nav>

            <div>
                <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Kontakt</h2>
                <address class="mt-4 space-y-3 text-sm not-italic text-slate-300">
                    <p>
                        {{ firma.name }}<br>
                        {{ firma.strasse }}<br>
                        {{ firma.plz }} {{ firma.ort }}
                    </p>
                    {% for p in firma.ansprechpartner %}
                    <p>
                        {{ p.name }}<br>
                        <a href="tel:{{ p.telefon | tel }}" class="{{ linkClass }}">{{ p.telefon }}</a>
                    </p>
                    {% endfor %}
                    <p>
                        <a href="mailto:{{ firma.email }}" class="{{ linkClass }}">{{ firma.email }}</a>
                    </p>
                </address>
            </div>
        </div>

        <div class="mt-10 border-t border-slate-700 pt-6 text-sm text-slate-400">
            <p class="mb-4 text-xs leading-relaxed text-slate-400">
                Diese Website verwendet keine Cookies, keine Analyse- und keine Tracking-Dienste und bindet keine Inhalte von Drittanbietern ein. Deshalb benötigen wir kein Cookie-Banner. Mehr dazu in der <a href="/datenschutz.html#cookies" class="{{ linkClass }} underline">Datenschutzerklärung</a>.
            </p>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <p>© {{ buildYear }} {{ firma.name }}. Alle Rechte vorbehalten.</p>
                <nav aria-label="Rechtliche Links">
                    <ul class="flex flex-wrap gap-4">
                        <li><a href="/impressum.html" class="{{ linkClass }}">Impressum</a></li>
                        <li><a href="/datenschutz.html" class="{{ linkClass }}">Datenschutz</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</footer>
