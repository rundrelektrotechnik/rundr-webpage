{%- set canonicalUrl = site.url + page.url -%}
{%- set shareImage = site.url + (image or site.ogImage) -%}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <meta name="robots" content="{{ 'noindex, follow' if noindex else 'index, follow' }}">
    <meta name="theme-color" content="{{ site.themeColor }}">
    <link rel="canonical" href="{{ canonicalUrl }}">

    {# Icons #}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    {# Open Graph / Twitter: previews for shared links #}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:locale" content="{{ site.locale }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <meta property="og:image" content="{{ shareImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ imageAlt or site.ogImageAlt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="{{ shareImage }}">

    <link rel="stylesheet" href="/css/style.css">

    {% if page.url == "/" %}
    {# Structured data for local search results #}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Electrician",
        "name": "{{ site.name | safe }}",
        "url": "{{ site.url }}/",
        "image": "{{ site.url }}{{ site.ogImage }}",
        "telephone": "{{ site.phone }}",
        "email": "{{ site.email }}",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "{{ site.street }}",
            "postalCode": "{{ site.postalCode }}",
            "addressLocality": "{{ site.city }}",
            "addressRegion": "{{ site.region }}",
            "addressCountry": "{{ site.country }}"
        }
    }
    </script>
    {% endif %}
</head>
<body class="font-sans text-slate-900 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:text-slate-900 focus:shadow">Zum Inhalt springen</a>

    {% include "partials/header.njk" %}

    <main id="main">
{{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}

    <script src="/js/menu.js" defer></script>
</body>
</html>
